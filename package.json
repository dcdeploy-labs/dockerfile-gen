{
  "name": "@dcdeploy/dockerfile-gen",
  "version": "1.0.0",
  "description": "A Node.js tool to automatically generate Dockerfiles for various languages and frameworks",
  "main": "src/index.js",
  "type": "module",
  "bin": {
    "docker-file-gen": "src/cli.js"
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "jest",
    "lint": "eslint src/**/*.js"
  },
  "keywords": [
    "docker",
    "dockerfile",
    "generator",
    "nodejs",
    "python",
    "go",
    "java",
    "angular",
    "vue",
    "django",
    "flask",
    "spring-boot",
    "framework",
    "automation",
    "cli",
    "devops",
    "containerization"
  ],
  "author": {
    "name": "Yogesh Agarwal",
    "email": "docker-file-gen@example.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saggiyogesh/dockerfile-gen.git"
  },
  "homepage": "https://github.com/saggiyogesh/dockerfile-gen#readme",
  "bugs": {
    "url": "https://github.com/saggiyogesh/dockerfile-gen/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "commander": "^11.1.0",
    "chalk": "^5.3.0",
    "inquirer": "^9.2.12",
    "fs-extra": "^11.1.1",
    "glob": "^10.3.10",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "eslint": "^8.55.0"
  }
}
